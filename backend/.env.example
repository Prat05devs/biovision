BIOVISION_ENV=development
BIOVISION_ALLOWED_ORIGINS=http://localhost:8765,http://localhost:8081
BIOVISION_RESEARCH_COLLECTION_ENABLED=false
BIOVISION_CAPTURE_STORAGE_ROOT=./backend/.data/captures
BIOVISION_CAPTURE_DB_PATH=./backend/.data/biovision.db
BIOVISION_MAX_CAPTURE_BYTES=15728640
# Optional research model. Install `backend[models]` before enabling.
BIOVISION_ANEMIA_MODEL_VERSION=galihkjaya/anemia-palor-detection@5659a76e6d3d
BIOVISION_ANEMIA_MODEL_PATH=./ml/models/anemia-palor-detection/model.pt
BIOVISION_ANEMIA_MODEL_CONFIG_PATH=./ml/models/anemia-palor-detection/config.json
