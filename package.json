{
  "name": "biovision",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:launch-check": "node scripts/check-ios-launch.cjs",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "backend:test": ".venv/bin/pytest -q backend/tests",
    "backend:check": ".venv/bin/ruff check backend && .venv/bin/mypy backend/app",
    "backend:dev": "BIOVISION_ANEMIA_MODEL_VERSION=galihkjaya/anemia-palor-detection@5659a76e6d3d BIOVISION_ALLOWED_ORIGINS=http://localhost:8765,http://localhost:8081 .venv/bin/uvicorn app.main:app --app-dir backend --reload",
    "data:check": "python3 ml/data/validate_registry.py",
    "test:health": "node scripts/test-health.cjs",
    "test:appearance": "node scripts/test-appearance.cjs",
    "test:vitals": "node scripts/test-vitals.cjs",
    "test:facephys-hrv": "node scripts/test-facephys-hrv.cjs",
    "test:routing": "node scripts/test-routing.cjs",
    "test:wellbeing": "node scripts/test-wellbeing.cjs",
    "landing:build": "node scripts/build-landing.cjs",
    "android:apk": "node scripts/build-android.cjs apk",
    "android:aab": "node scripts/build-android.cjs aab"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "biovision-facephys": "file:modules/biovision-facephys",
    "expo": "~57.0.21",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.16",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.20",
    "expo-sharing": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "i18next": "^26.4.1",
    "lucide": "^1.39.0",
    "morphicons": "^1.7.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-worklets": "^5.2.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.10.1",
    "vitalcamera-sdk": "^0.6.9",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "nitrogen": "^0.37.1",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
