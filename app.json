{
  "expo": {
    "name": "BioVision",
    "slug": "biovision",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "biovision",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "8",
      "bundleIdentifier": "live.biovision.app",
      "infoPlist": {
        "NSCameraUsageDescription": "BioVision uses the front camera during your health scan to measure your pulse and photograph your face and lower eyelids. Video is analysed on your iPhone and never recorded or uploaded.",
        "NSMotionUsageDescription": "BioVision's camera uses the motion sensor to keep the picture the right way up while you scan. Motion data stays on your iPhone and is never recorded or uploaded.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "x-apple-health",
          "fitbit",
          "strava"
        ]
      }
    },
    "android": {
      "package": "live.biovision.app",
      "permissions": [
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F8F7",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BioVision to use your camera for health pre-screening captures.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-localization",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
